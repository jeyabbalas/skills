.idea/
.DS_Store

# examples/: paper PDFs are under arXiv's non-exclusive license (no third-party
# redistribution) and reproduction fixtures regenerate byte-identically —
# each example's README says how to restore both.
examples/**/paper.pdf
examples/**/reproduction/code/data/

# examples/: book files stay untracked (license hygiene — the example README says
# how to restore them) and extract/ caches regenerate from the ingest scripts.
examples/**/book.pdf
examples/**/book.epub
examples/**/extract/
node_modules/
__pycache__/
*.pyc
.venv/
